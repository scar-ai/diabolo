VITE_BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:password@localhost:5432/tanstarter"
# You can also use Docker Compose to set up a local PostgreSQL database:
# docker-compose up -d

# pnpm run auth:secret
BETTER_AUTH_SECRET=

# OAuth2 providers, optional, update as needed
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Daytona, optional, required for the sandbox clone flow
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
# Leave blank to use Daytona's default sandbox image for the selected target.
# Do not set this to `daytonaio/workspace` or `daytonaio/workspace:latest`.
DAYTONA_DEFAULT_IMAGE=

# OpenCode via OpenRouter, required for the background repo agent flow
OPENROUTER_API_KEY=
# Use the full OpenCode model id. For OpenRouter models, either
# `openrouter/openai/gpt-5-codex` or shorthand like `nvidia/...` works.
OPENCODE_MODEL=openrouter/openai/gpt-5-codex

# NOTE:
# In your OAuth2 apps, set callback/redirect URIs to`http://localhost:3000/api/auth/callback/<provider>`
# e.g. http://localhost:3000/api/auth/callback/github
