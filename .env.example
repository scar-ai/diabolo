VITE_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:password@localhost:5432/tanstarter

BETTER_AUTH_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
# Optional base image used to build the managed Daytona browser snapshot.
# Defaults to `node:22-bookworm` when unset.
DAYTONA_DEFAULT_IMAGE=
DAYTONA_BROWSER_BASE_IMAGE=
# Optional snapshot name override for the prebuilt OpenCode + agent-browser image.
DAYTONA_BROWSER_SNAPSHOT=

# Optional absolute WebSocket endpoint. Defaults to the current host.
VITE_TASK_WEBSOCKET_URL=

# Optional Stripe billing. Configure all four values to enable paid plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_MAX_PRICE_ID=
